# BMGenie CRM API — environment template (copy to .env on the server)
# For Windows production zip we ship a filled ENV-FOR-WINDOWS.env — rename that to .env

PORT=4050
NODE_ENV=production

# Public URLs (live)
FRONTEND_URL=https://crm.bmgenie.ai
PUBLIC_API_URL=https://crm-api.bmgenie.ai
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=https://crm.bmgenie.ai,https://bmg-crm.vercel.app

# Auth — replace with long random values in production
JWT_SECRET=replace-with-long-random-secret
# Must match main BMGenie API env CRM_INGEST_API_KEY when product sync is enabled
CRM_INGEST_API_KEY=replace-with-shared-ingest-secret

# Optional: absolute path to SQLite file (default: ./data/crm.db under this app)
# DATABASE_PATH=D:\bmg-crm\data\crm.db
